# ============================================================
# Demony Platform - Backend Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database (MongoDB) ----
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/demony?retryWrites=true&w=majority

# ---- Authentication ----
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ---- Paystack (Payment Gateway - Ghana) ----
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ---- Brevo (Email Service) ----
# Get API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
MAIL_FROM=no-reply@demony.com

# ---- URLs ----
WEB_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
MOBILE_URL=capacitor://localhost

# ---- CORS ----
# Comma-separated list of additional allowed origins
ALLOWED_ORIGINS=

# ---- Email Verification ----
# Set to 'true' to skip email verification in development
SKIP_EMAIL_VERIFICATION=true

# ---- Support ----
SUPPORT_EMAIL=support@demony.com
